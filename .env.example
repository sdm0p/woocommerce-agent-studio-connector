# Replace locally; never commit the populated .env file.
WC_STORE_URL=https://your-test-store.example
WC_CONSUMER_KEY=replace-with-read-only-consumer-key
WC_CONSUMER_SECRET=replace-with-consumer-secret
# Generate separately: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_BEARER_TOKEN=replace-with-a-random-token-at-least-32-characters
# True ONLY for the local demo/test store. HTTPS remains mandatory elsewhere.
WC_ALLOW_LOCAL_HTTP=false
# Optional trusted CA PEM file for the local HTTPS Docker lab; leave empty for public stores.
WC_CA_BUNDLE=
