            "default": null,
            "title": "Before"
          },
          "page": {
            "default": 1,
            "exclusiveMinimum": 0,
            "title": "Page",
            "type": "integer"
          },
          "per_page": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "title": "Per Page",
            "type": "integer"
          }
        },
