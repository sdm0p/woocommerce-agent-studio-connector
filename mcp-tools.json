    {
      "name": "search_orders",
      "description": "Find orders using combined filters (AND). Supply at least one filter. customer_id is a registered customer ID, not a name/email; guest ID 0 cannot be filtered. query uses native WooCommerce text search, not exact customer lookup. Dates require ISO8601 with timezone and are normalized to UTC.",
      "inputSchema": {
        "properties": {
          "customer_id": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Customer Id"
          },
          "status": {
            "anyOf": [
              {
                "enum": [
                  "pending",
                  "processing",
                  "on-hold",
                  "completed",
                  "cancelled",
                  "refunded",
                  "failed",
                  "trash",
                  "any"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Status"
          },
          "query": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Query"
          },
          "after": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
